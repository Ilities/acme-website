---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/date';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog"
  description="Notes from the Acme Book team on running a clinic or studio, product updates and practical advice."
>
  <section class="page-header">
    <div class="container narrow">
      <span class="eyebrow">Blog</span>
      <h1>Notes from the team</h1>
      <p class="lead">
        Practical advice for running a clinic or studio, and the occasional product update.
      </p>
    </div>
  </section>

  <section class="section posts-section">
    <div class="container narrow">
      <ul class="posts">
        {
          posts.map((post) => (
            <li>
              <article>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                <h2>
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p>{post.data.description}</p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .posts-section {
    padding-top: 1rem;
  }

  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts li {
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-line);
  }

  time {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  h2 {
    margin: 0.3rem 0 0.5rem;
    font-size: 1.4rem;
  }

  h2 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--color-brand);
    text-decoration: underline;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }
</style>
