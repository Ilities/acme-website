---
import { plans, comparisonRows, formatPrice } from '../data/plans';
---

<div class="plans">
  {
    plans.map((plan) => (
      <div class:list={['plan', { highlighted: plan.highlighted }]}>
        {plan.highlighted && <span class="badge">Most popular</span>}
        <h3>{plan.name}</h3>
        <p class="summary">{plan.summary}</p>
        <p class="price">
          <span class="amount">{formatPrice(plan.monthlyPrice)}</span>
          <span class="period">/ month</span>
        </p>
        <p class="annual-price">
          or {formatPrice(plan.annualMonthlyPrice)} / month billed annually ({formatPrice(plan.annualTotal)} a year)
        </p>
        <p class="setup-fee">No setup fee if you start before 31.3.2027</p>
        <p class="limits">
          {plan.staff}
          <br />
          {plan.locations}
        </p>
        <a class:list={['button', { 'button--outline': !plan.highlighted }]} href="/contact">
          Start free trial
        </a>
        <ul>
          {plan.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<div class="table-wrap">
  <table>
    <caption class="visually-hidden">Plan comparison</caption>
    <thead>
      <tr>
        <th scope="col">Compare plans</th>
        {
          plans.map((plan) => (
            <th scope="col">
              {plan.name}
              <span class="th-price">
                {formatPrice(plan.monthlyPrice)} / month<br />
                or {formatPrice(plan.annualMonthlyPrice)} billed annually
              </span>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        comparisonRows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            {plans.map((plan) => {
              const value = row.values[plan.id];
              if (value === true) return <td><span class="yes">&#10003;</span><span class="visually-hidden">Included</span></td>;
              if (value === false || value === undefined) return <td><span class="no">&ndash;</span><span class="visually-hidden">Not included</span></td>;
              return <td>{value}</td>;
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .plans {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 900px) {
    .plans {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }

  .plan {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 2rem 1.75rem;
  }

  .plan.highlighted {
    border: 2px solid var(--color-brand);
    box-shadow: var(--shadow);
  }

  .badge {
    position: absolute;
    top: -0.8rem;
    left: 1.75rem;
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    background: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .summary {
    color: var(--color-muted);
    min-height: 3.2em;
  }

  .price {
    margin-bottom: 0.5rem;
  }

  .annual-price,
  .setup-fee {
    margin: 0.35rem 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .setup-fee {
    margin-bottom: 1rem;
  }

  .amount {
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .period {
    color: var(--color-muted);
  }

  .limits {
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  .plan .button {
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .plan ul {
    margin: 0;
    padding: 1.25rem 0 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
    font-size: 0.95rem;
  }

  .plan li + li {
    margin-top: 0.5rem;
  }

  .plan li::before {
    content: '\2713';
    margin-right: 0.5rem;
    color: var(--color-brand);
    font-weight: 700;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  th,
  td {
    padding: 0.8rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--color-line);
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  thead th {
    background: var(--color-sand);
    font-size: 1rem;
    vertical-align: bottom;
  }

  .th-price {
    display: block;
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  tbody th {
    font-weight: 500;
  }

  .yes {
    color: var(--color-brand);
    font-weight: 700;
  }

  .no {
    color: #a7aeab;
  }
</style>
