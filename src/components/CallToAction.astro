---
interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Try Acme Book free for 30 days',
  text = 'No card needed. We can help you move your existing bookings and customer list over.',
} = Astro.props;
---

<section class="cta">
  <div class="container inner">
    <div>
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="button-row">
      <a class="button" href="/contact">Book a demo</a>
      <a class="button button--outline" href="/pricing">See pricing</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: 3.5rem;
    background: var(--color-brand-light);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  h2 {
    margin-bottom: 0.3rem;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }
</style>
